# Required — text and menu modes need only this. Jev runs on the official TypeSafe API.
TYPESAFE_API_KEY=

# Optional. Defaults to jev-latest.
# TYPESAFE_DEFAULT_MODEL=jev-latest

# Optional — only photo mode (the eye) and "race an LLM" (the opponent) need this.
# Both go through OpenRouter via AI SDK 7.
OPENROUTER_API_KEY=
# VLM_MODEL=google/gemini-2.5-flash
# RACE_MODEL=google/gemini-2.5-flash
